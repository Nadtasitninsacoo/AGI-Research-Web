# Engine worker configuration.
# Copy into the project .env.local (shared with the web app) or engine/.env,
# then run:  node --env-file=.env.local engine/src/index.mjs

# --- MySQL (reuse the same values as the web app) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=agi_research
DATABASE_USER=agi_app
DATABASE_PASSWORD=

# --- Ollama ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TEMPERATURE=0.2

# --- Gemini (automatic fallback — only used when Ollama is unreachable,
# e.g. not installed on this machine, not running, or the model is missing).
# Leave GEMINI_API_KEY empty to keep the engine Ollama-only (default).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_MS=120000
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096

# --- DARK AGI Windows Execution API (external tool platform — optional) ---
# Separate platform, own process, own auth/scope/approval/audit. Leave
# DARK_AGI_API_KEY empty to disable this tool entirely (default).
# Create a key at http://127.0.0.1:7410/api-access (do NOT grant jobs:approve).
DARK_AGI_API_KEY=
DARK_AGI_URL=http://127.0.0.1:7411/api/v1
DARK_AGI_TIMEOUT_MS=30000

# --- Worker behaviour ---
ENGINE_POLL_MS=2000
ENGINE_MAX_STEPS=20
ENGINE_CMD_TIMEOUT_MS=120000
ENGINE_MAX_OUTPUT_CHARS=12000
# Working directory for executed commands (default: repo root)
ENGINE_WORKDIR=

# Leave false for real engagements. When false, intrusive actions
# (exploitation, credential attacks) require an approval token in
# agents.config.approvedActions or the run's params.approvedActions.
ENGINE_AUTO_APPROVE_INTRUSIVE=false
