# MySQL (used by src/lib/db.ts, /api/db-health and scripts/db-*.mjs)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=agi_research
DATABASE_USER=agi_app
DATABASE_PASSWORD=

# AGI backend (server-side only, never expose as NEXT_PUBLIC_*)
AGI_API_URL=
AGI_API_TOKEN=

# Strategic map imagery. Optional: set a Mapbox access token to unlock sharp,
# deep (z22) satellite imagery with full global coverage — including rural areas
# where the free Esri fallback shows "Map data not yet available". Get a free
# token at https://account.mapbox.com/access-tokens/ . Left empty, the map uses
# Esri World Imagery (free, no key). This one is public by design (NEXT_PUBLIC_).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Shodan OSINT (optional, server-only). Set an API key to enable the map's
# "หา host ใน<พื้นที่>" / "shodan <area>" command: it READS Shodan's pre-indexed
# host database for an area and pins the results (IP, open ports, service) — it
# performs NO active scan. Get a key at https://account.shodan.io/ . Search
# queries consume Shodan credits; results cover only what Shodan has indexed.
# Server-only (no NEXT_PUBLIC_) so the key never reaches the browser.
SHODAN_API_KEY=
